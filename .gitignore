# El dataset son fotos de personas reales: no se publica.
data/face-mask-data/images/
data/face-mask-data/labels/
data/face-mask-data/train/
data/face-mask-data/val/
runs/split/

# Deny por defecto en pesos: Ultralytics los reescribe cada save_period, así que
# versionarlos solo infla el repo. Las excepciones van ancladas a la raíz para
# que no re-incluyan copias en subcarpetas.
*.pt*
*.onnx
*.engine
!/yolo11n.pt

# Restos del clasificador ResNet18, que ya no está en el pipeline.
*.pth
face_mask/
models/

# Los JPG del trainer son mosaicos que re-embeben caras del dataset. Los PNG de
# métricas sí se versionan, y results.csv con ellos.
runs/**/*.jpg

# args.yaml guarda la ruta absoluta del host, así que no es portable.
**/args.yaml
**/labels.cache

# Se regenera en runtime con una ruta absoluta.
training/face_mask_dataset.yaml

venv/
.venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
.netrc
.pypirc
.npmrc
*.local
*.log

.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Streams de WSL al descargar ficheros en Windows.
*.Identifier
.cache/
